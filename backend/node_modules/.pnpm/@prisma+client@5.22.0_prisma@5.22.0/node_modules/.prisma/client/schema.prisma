// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. BETTER AUTH TABLES (WITH RBAC ROLE)
// ==========================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  // Custom Role Field for Admin & Supervisor access
  role String? @default("user") // Values: 'admin', 'supervisor', 'user'

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ==========================================
// 2. NTPL PROJECT MODULES
// ==========================================

model ProjectSite {
  id String @id @default(uuid())

  // Module 1: Project Information
  siteName  String
  location  String
  state     String
  startDate DateTime?

  // Module 2: Civil Structure Status
  // Values: 'PENDING', 'IN_PROGRESS', 'COMPLETED'
  civilStatus String @default("PENDING")

  // Module 3: Structural Engineering (Solar) Status
  // Values: 'PENDING', 'MATERIAL_ARRIVED', 'FRAME_FITTED', 'PANELS_MOUNTED'
  structuralStatus String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  // Relation to link images to this site
  images SiteImage[]

  // NEW: Relation to link payment milestones to this site
  milestones PaymentMilestone[]

  @@map("project_site")
}

// Table to store multiple photos per site & phase
model SiteImage {
  id         String      @id @default(uuid())
  url        String // Example: "http://localhost:5000/uploads/photo1.jpg"
  phase      String // Values: "PHASE 1" or "PHASE 2"
  projectId  String
  site       ProjectSite @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy String?
  createdAt  DateTime    @default(now())

  @@map("site_image")
}

// NEW: Table to store payment milestones for billing and invoicing
model PaymentMilestone {
  id        String      @id @default(uuid())
  name      String
  amount    Float
  status    String      @default("PENDING") // Values: 'PENDING' or 'PAID'
  paidAt    DateTime?
  projectId String
  site      ProjectSite @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@map("payment_milestone")
}

model ActivityLog {
  id       String @id @default(uuid())
  username String
  action   String
  details  String

  projectId String
  project   ProjectSite @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
